{
  "name": "micro-rsa-dsa-dh",
  "version": "0.2.1",
  "description": "Minimal implementation of older cryptography algorithms: RSA, DSA, DH, ElGamal",
  "files": [
    "*.js",
    "*.d.ts",
    "*.map",
    "src"
  ],
  "dependencies": {
    "@noble/hashes": "^2.0.0-beta.5"
  },
  "devDependencies": {
    "@paulmillr/jsbt": "0.4.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "scripts": {
    "build": "tsc",
    "build:release": "npx --no @paulmillr/jsbt esbuild test/build",
    "format": "prettier --write 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
    "test": "node test/index.ts",
    "test:bun": "bun test/index.ts",
    "test:deno": "deno --allow-env --allow-read test/index.ts",
    "test:node20": "cd test; npx tsc; node compiled/test/index.js"
  },
  "keywords": [
    "rsa",
    "dsa",
    "dh",
    "elgamal",
    "diffie-hellman",
    "prime",
    "cryptography",
    "noble"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmillr/micro-rsa-dsa-dh.git"
  },
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "author": "Paul Miller (https://paulmillr.com)",
  "license": "MIT"
}
